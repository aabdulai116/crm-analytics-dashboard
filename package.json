{
  "name": "crm-analytics-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Full stack CRM analytics dashboard built with React, Node.js, Express and SQLite",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "generate:sample": "node scripts/generateSampleCsv.js 50 sample-data/sample_crm.csv",
    "generate:10k": "node scripts/generateSampleCsv.js 10000 sample-data/sample_crm_10k.csv",
    "seed:10k": "node scripts/seed.js sample-data/sample_crm_10k.csv",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:no-index": "node scripts/benchmark.js --no-index"
  },
  "license": "MIT"
}
